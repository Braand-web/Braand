{
  "name": "braand",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings=0",
    "test": "node tests/run-tests.mjs",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:integration": "node tests/run-tests.mjs integration",
    "test:artifacts": "node tests/run-tests.mjs artifacts",
    "test:file-preview-bundle": "node --test tests/file-preview-bundle.test.mjs",
    "test:http-integration": "node tests/run-http-integration.mjs",
    "test:worker-config": "node --test tests/worker-config.test.mjs",
    "test:file-upload-integration": "node tests/run-file-upload-integration.mjs",
    "db:generate": "drizzle-kit generate",
    "cloudflare:config": "node scripts/cloudflare-config.mjs",
    "cloudflare:deploy:staging": "wrangler deploy --config .wrangler/deploy/staging.json",
    "cloudflare:deploy:production": "wrangler deploy --config .wrangler/deploy/production.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/sandbox": "1.0.3",
    "@composio/anthropic": "0.11.7",
    "@composio/core": "0.25.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "0.3.1",
    "bot-avatars": "0.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "1.5.0",
    "jose": "6.2.15",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-resizable-panels": "4.18.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "json-rpc-2.0": "1.8.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.3.6",
    "wrangler": "4.116.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "image-size": "2.0.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/server-legacy": "2.4.0",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "ws": "8.22.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@hono/node-server": "2.1.5"
  }
}
