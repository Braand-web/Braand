{
  "name": "braand",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings=0",
    "test": "node tests/run-tests.mjs",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:integration": "node tests/run-tests.mjs integration",
    "test:artifacts": "node tests/run-tests.mjs artifacts",
    "test:file-preview-bundle": "node --test tests/file-preview-bundle.test.mjs",
    "test:http-integration": "node tests/run-http-integration.mjs",
    "test:worker-config": "node --test tests/worker-config.test.mjs",
    "test:file-upload-integration": "node tests/run-file-upload-integration.mjs",
    "db:generate": "drizzle-kit generate",
    "cloudflare:config": "node scripts/cloudflare-config.mjs",
    "cloudflare:deploy:staging": "wrangler deploy --config .wrangler/deploy/staging.json",
    "cloudflare:deploy:production": "wrangler deploy --config .wrangler/deploy/production.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/sandbox": "1.0.3",
    "@composio/anthropic": "0.11.5",
    "@composio/core": "0.25.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "bot-avatars": "0.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.6.7",
    "react": "19.2.9",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.0",
    "@cloudflare/workers-types": "4.20260617.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.102.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "image-size": "2.0.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/server-legacy": "2.4.0",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "ws": "8.22.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@hono/node-server": "2.1.5"
  }
}
